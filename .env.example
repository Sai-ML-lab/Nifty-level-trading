# Upstox credentials — keep private; never commit real tokens.
UPSTOX_BASE_URL=https://api.upstox.com
UPSTOX_ORDER_BASE_URL=https://api-hft.upstox.com
NIFTY_INSTRUMENT_KEY=NSE_INDEX|Nifty 50

# Local persistence
TRADER_DB_PATH=data/trader.sqlite3
TRADER_DATA_DIR=data
POLL_SECONDS=60
STALE_DATA_SECONDS=180
MAX_SIGNAL_AGE_SECONDS=180
LAST_ENTRY_TIME=15:00

# Strategy (completed 5-minute candles)
SMA_FILTER_ENABLED=1
FVG_FILTER_ENABLED=1
RSI_DIVERGENCE_REQUIRED=0
IMMEDIATE_ENTRY_ENABLED=1
RETEST_ENTRY_ENABLED=1
RETEST_BARS=3
PIVOT_LEFT=3
PIVOT_RIGHT=3
RSI_PERIOD=14
BREAKOUT_BUFFER_POINTS=2.0
RETEST_TOLERANCE_POINTS=8.0
ATR_STOP_MULTIPLIER=1.0
MIN_REWARD_RISK=1.2

# Option selection
MIN_PREMIUM_INR=30
MAX_PREMIUM_INR=500
MAX_SPREAD_PCT=0.08
MIN_OPTION_VOLUME=1000
MIN_OPTION_OI=10000
# Directional strike selection. OTM_BAND is a hard filter with no ATM fallback.
# LONG selects CE strikes 150-200 points above spot; SHORT selects PE strikes 150-200 below spot.
OPTION_SELECTION_MODE=OTM_BAND
OPTION_OTM_MIN_POINTS=150
OPTION_OTM_MAX_POINTS=200
# Used only when OPTION_SELECTION_MODE=NEAR_ATM.
OPTION_MONEYNESS_PCT=0.01

# Risk and simulation
MAX_TRADES_PER_DAY=2
MAX_DAILY_LOSS_INR=2000
RISK_PER_TRADE_INR=2000
MAX_LOTS=1
MAX_POSITION_VALUE_INR=15000
PREMIUM_STOP_LOSS_PCT=0.35
SLIPPAGE_POINTS=0.5
MAX_APPROVAL_PRICE_DRIFT_PCT=0.02
ESTIMATED_ROUND_TRIP_COST_PER_LOT=100

# Live trading: keep BOTH off until fully validated.
LIVE_TRADING_ENABLED=0
ALLOW_LIVE_ORDERS=0
LIVE_PRODUCT=I
